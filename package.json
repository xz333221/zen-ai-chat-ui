{
  "name": "zen-ai-chat-ui",
  "version": "0.1.0-beta.7",
  "description": "一个精美的大模型对话 UI 组件库，基于 Vue 3 + TypeScript。支持流式输出、思考过程折叠、Markdown 渲染（Shiki 代码高亮）、附件上传、追问建议、浅色/深色双主题。可发布到 NPM，供其他项目安装复用。",
  "type": "module",
  "license": "MIT",
  "author": "xzisme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz333221/zen-ai-chat-ui.git"
  },
  "homepage": "https://github.com/xz333221/zen-ai-chat-ui#readme",
  "bugs": {
    "url": "https://github.com/xz333221/zen-ai-chat-ui/issues"
  },
  "keywords": [
    "chat",
    "llm",
    "ai",
    "vue",
    "component",
    "streaming",
    "markdown",
    "thinking",
    "reasoning",
    "followup",
    "suggestions"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/ai-chat-ui.umd.js",
  "module": "./dist/ai-chat-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-chat-ui.es.js",
      "require": "./dist/ai-chat-ui.umd.js"
    },
    "./style.css": "./dist/ai-chat-ui.css",
    "./dist/style.css": "./dist/ai-chat-ui.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "release": "node scripts/release.js"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "shiki": "^1.22.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "sass": "^1.80.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
